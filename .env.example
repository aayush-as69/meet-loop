# Copy to .env and fill in. Never commit .env.
# Use ONE of these. Gemini works too (https://aistudio.google.com/apikey):
GEMINI_API_KEY=your-gemini-key-here
# ANTHROPIC_API_KEY=your-key-here   # if set, this takes priority over Gemini

# Optional
# MEETLOOP_MODEL=gemini-flash-latest   # default for Gemini; default for Anthropic is claude-sonnet-5-5
# MEETLOOP_EXTRACTOR=auto      # auto = LLM with rule-based fallback, rules = never call the API
# MEETLOOP_LLM_TIMEOUT=60      # seconds

# Stage 3: posting approved action items to GitHub (required for "Confirm & Post")
# Token needs Issues: read & write on the repo. Never commit .env.
GITHUB_TOKEN=your-github-token
GITHUB_REPO=owner/name
# Optional: public address of this app, used for the meeting link inside each issue
# (defaults to the address your browser used, which is useless to teammates on localhost)
# MEETLOOP_BASE_URL=https://meetloop.example.com
